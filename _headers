let allItems=[],current='All';const $=id=>document.getElementById(id);const esc=(s='')=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));document.querySelector('.menu')?.addEventListener('click',()=>document.querySelector('.header nav')?.classList.toggle('open'));const card=i=>`<article class="card"><img src="${esc(i.image)}" alt="${esc(i.title)}" loading="lazy"><div class="card-body"><span class="badge">${esc(i.category)} • ${esc(i.store)}</span><h3>${esc(i.title)}</h3><p>${esc(i.description)}</p><a class="btn" href="${esc(i.url)}" target="_blank" rel="noopener">Shop on ${esc(i.store)}</a></div></article>`;function renderFilters(){if(!$('filters'))return;const cats=['All',...new Set(allItems.map(x=>x.category))];$('filters').innerHTML=cats.map(c=>`<button class="filter ${c===current?'active':''}" data-c="${esc(c)}">${esc(c)}</button>`).join('');$('filters').querySelectorAll('button').forEach(b=>b.onclick=()=>{current=b.dataset.c;renderFilters();renderGallery()})}function renderGallery(){if(!$('galleryGrid'))return;const q=($('searchBox')?.value||'').toLowerCase();const items=allItems.filter(i=>(current==='All'||i.category===current)&&(`${i.title} ${i.category} ${i.description}`.toLowerCase().includes(q)));$('galleryGrid').innerHTML=items.length?items.map(card).join(''):'<p>No matching items found.</p>'}fetch('data/site.json').then(r=>r.json()).then(d=>{const s=d.site||{};if($('brand'))$('brand').textContent=s.brand;if($('tagline'))$('tagline').textContent=s.tagline;if($('heroText'))$('heroText').textContent=s.heroText;if($('aboutShort'))$('aboutShort').textContent=s.about;if($('aboutLong'))$('aboutLong').textContent=s.about;document.querySelectorAll('#picfairBtn').forEach(a=>a.href=s.picfair);document.querySelectorAll('#teepublicBtn').forEach(a=>a.href=s.teepublic);if(s.email&&$('emailBtn')){$('emailBtn').classList.remove('hidden');$('emailBtn').href='mailto:'+s.email}if($('featuredGrid'))$('featuredGrid').innerHTML=(d.featured||[]).map(x=>`<article class="feature" style="background-image:url('${esc(x.image)}')"><div class="feature-copy"><span class="eyebrow">${esc(x.subtitle)}</span><h3>${esc(x.title)}</h3><p>${esc(x.description)}</p><a class="btn orange" href="${esc(x.url)}" target="_blank">${esc(x.button)}</a></div></article>`).join('');allItems=d.gallery||[];renderFilters();renderGallery();$('searchBox')?.addEventListener('input',renderGallery);if($('photoGrid'))$('photoGrid').innerHTML=allItems.filter(x=>x.store==='Picfair').map(card).join('');if($('apparelGrid'))$('apparelGrid').innerHTML=allItems.filter(x=>x.store==='TeePublic').map(card).join('');const guide=(g,long=false)=>`<article class="guide"><div class="icon">${esc(g.icon)}</div><h3>${esc(g.title)}</h3><p>${esc(long?g.body:g.summary)}</p></article>`;if($('guideGrid'))$('guideGrid').innerHTML=(d.guides||[]).map(g=>guide(g)).join('');if($('guideLongGrid'))$('guideLongGrid').innerHTML=(d.guides||[]).map(g=>guide(g,true)).join('')}).catch(console.error);
