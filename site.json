
:root{--forest:#103d2b;--leaf:#20704d;--orange:#ed8b32;--sand:#f3ecdf;--cream:#fbf8f2;--ink:#17221b;--white:#fff}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:"DM Sans",sans-serif;color:var(--ink);background:var(--cream)}a{color:inherit}img{max-width:100%}.site-header{position:absolute;z-index:20;top:0;left:0;width:100%;display:flex;align-items:center;justify-content:space-between;padding:22px clamp(20px,6vw,90px);color:white}.site-header:not(:has(+ main .hero)){position:relative;background:var(--forest)}.logo{text-decoration:none;font-size:1.5rem;font-weight:700}.logo span{color:#ffd39f}.main-nav{display:flex;gap:22px}.main-nav a{text-decoration:none;font-weight:600}.menu-button{display:none;background:none;border:0;color:white;font-size:1.7rem}.hero{min-height:94vh;display:grid;place-items:center;position:relative;text-align:center;color:white;background:url("https://images.unsplash.com/photo-1516690561799-46d8f74f9abf?auto=format&fit=crop&w=2200&q=90") center/cover}.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,28,20,.30),rgba(7,28,20,.84))}.hero-content{position:relative;max-width:900px;padding:130px 24px 80px}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-weight:700;font-size:.78rem;color:var(--orange)}h1,h2{font-family:"Playfair Display",serif}.hero h1{font-size:clamp(4rem,11vw,7.8rem);line-height:.94;margin:.16em 0}.hero-tagline{font-size:clamp(1.1rem,2vw,1.4rem);font-weight:700}.hero-intro{max-width:720px;margin:20px auto;line-height:1.7}.button-row{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin-top:28px}.button{display:inline-block;padding:14px 22px;border-radius:999px;text-decoration:none;font-weight:700}.primary{background:var(--orange);color:#1e160e}.secondary{border:2px solid white;color:white}.dark{background:var(--forest);color:white}.outline{border:2px solid var(--forest);color:var(--forest)}.section{padding:90px clamp(20px,6vw,90px)}.white{background:white}.sand{background:var(--sand)}.green{background:var(--forest);color:white}.section-heading{max-width:780px;text-align:center;margin:0 auto 38px}.section-heading h2,.split-copy h2,.narrow h2,.contact-panel h2{font-size:clamp(2.2rem,5vw,4rem);margin:10px 0}.section-heading p:last-child{line-height:1.65}.light h2{color:white}.card-grid,.collection-grid,.guide-grid{max-width:1220px;margin:auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:24px}.card,.collection-card{background:white;border-radius:22px;overflow:hidden;box-shadow:0 15px 35px rgba(20,49,36,.10);display:flex;flex-direction:column}.card img,.collection-card img{width:100%;height:250px;object-fit:cover}.card-body,.collection-body{padding:22px;display:flex;flex-direction:column;flex:1}.badge{font-size:.74rem;text-transform:uppercase;letter-spacing:.1em;color:var(--leaf);font-weight:700}.card h3,.collection-card h3{font-size:1.4rem;margin:8px 0}.card p,.collection-card p{line-height:1.58;color:#536059;flex:1}.card .button{background:var(--forest);color:white;text-align:center}.collection-card{text-decoration:none}.split-section{display:grid;grid-template-columns:1fr 1fr;min-height:600px}.split-image{background:url("https://images.unsplash.com/photo-1472396961693-142e6e269027?auto=format&fit=crop&w=1500&q=85") center/cover}.split-copy{padding:80px clamp(30px,7vw,110px);display:flex;flex-direction:column;justify-content:center;background:white}.split-copy p{line-height:1.8}.text-link{font-weight:700;color:var(--leaf)}.market-grid{max-width:1000px;margin:auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px}.market-card{padding:34px;border-radius:22px;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.15)}.market-card p{line-height:1.7;color:#dbe8e0}.page-hero{min-height:55vh;display:grid;place-items:center;text-align:center;color:white;padding:120px 24px 70px;background-size:cover;background-position:center;position:relative}.page-hero:before{content:"";position:absolute;inset:0;background:rgba(10,35,25,.62)}.page-hero>div{position:relative;max-width:850px}.page-hero h1{font-size:clamp(3.2rem,8vw,6rem);margin:.15em 0}.photo-hero{background-image:url("https://images.unsplash.com/photo-1444464666168-49d633b86797?auto=format&fit=crop&w=1800&q=90")}.apparel-hero{background-image:url("https://images.unsplash.com/photo-1523381210434-271e8be1f52b?auto=format&fit=crop&w=1800&q=90")}.guides-hero{background-image:url("https://images.unsplash.com/photo-1473445361085-b9a07f55608b?auto=format&fit=crop&w=1800&q=90")}.about-hero{background-image:url("https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=1800&q=90")}.contact-hero{background-image:url("https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1800&q=90")}.guide-card{padding:30px;border-radius:22px;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.14)}.guide-card p{line-height:1.7;color:#dce9e1}.narrow{max-width:900px;margin:auto}.large-copy{font-size:1.15rem;line-height:1.9}.contact-panel{max-width:850px;margin:auto;text-align:center;background:white;border-radius:24px;padding:50px;box-shadow:0 18px 45px rgba(20,49,36,.10)}.center{text-align:center}.hidden{display:none}.site-footer{background:#0b2c20;color:white;text-align:center;padding:42px 20px}.footer-links{display:flex;justify-content:center;gap:22px}.footer-links a{color:#ffd4a5}@media(max-width:820px){.menu-button{display:block}.main-nav{display:none;position:absolute;right:20px;top:68px;background:rgba(11,44,32,.98);padding:20px;border-radius:14px;flex-direction:column}.main-nav.open{display:flex}.split-section{grid-template-columns:1fr}.split-image{min-height:380px}}
